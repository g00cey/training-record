# これをコピーして .env を作る:  cp .env.example .env
# API 認証キー。必ず生成し直すこと:  openssl rand -hex 32
API_KEY=change-me-generate-with-openssl-rand-hex-32

# --- スピン画像抽出（Phase 7・任意） ---
# Hermes Agent の画像抽出エンドポイント。未設定なら Web UI の「画像から入力」は
# 503（機能無効）になる。例: http://192.168.1.50:9000/extract-spin
#HERMES_API_URL=
# Hermes 側の認証キー（Hermes Agent に生成してもらう）
#HERMES_API_KEY=
