# これをコピーして .env を作る:  cp .env.example .env
# API 認証キー。必ず生成し直すこと:  openssl rand -hex 32
API_KEY=change-me-generate-with-openssl-rand-hex-32

# --- スピン画像抽出（Phase 7・任意） ---
# Hermes Agent の画像抽出エンドポイント。未設定なら Web UI の「画像から入力」は
# 503（機能無効）になる。例: http://192.168.1.50:9000/extract-spin
#HERMES_API_URL=
# Hermes 側の認証キー（Hermes Agent に生成してもらう）
#HERMES_API_KEY=

# --- LLM トレーニング評価（Phase 8・任意） ---
# llm/ の評価エンドポイント。未設定だと日次バッチ（server -evaluate-training）は
# 失敗する（Web UI 自体は動作し、GET /api/training-evaluations/* は 404 /
# 空配列を返し続ける）。例: http://192.168.1.50:9000/evaluate-training
#LLM_EVAL_API_URL=
# llm/ 側の TRAINING_EVAL_API_KEY と同じ値
#LLM_EVAL_API_KEY=
# 評価対象とする直近の週数（既定 8）
#LLM_EVAL_HISTORY_WEEKS=8
