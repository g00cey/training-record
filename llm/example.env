# Lemonade Server（OpenAI 互換 API）。未設定時は http://172.16.1.20:13305/api/v1
# LEMONADE_BASE_URL=http://172.16.1.20:13305/api/v1
# 認証が必要な場合のみ設定
# LEMONADE_API_KEY=
SPIN_EXTRACT_API_KEY=
# トレーニング評価（POST /evaluate-training）用の Bearer キー。未設定でもサーバは
# 起動するが、このエンドポイントは 503 を返す。backend の LLM_EVAL_API_KEY と一致させる
TRAINING_EVAL_API_KEY=
